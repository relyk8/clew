# Clew machine-local config — template. Never commit real paths, hostnames, or
# credentials; both destinations below are gitignored or outside the repo.
#
# Two places clew reads this from, in decreasing precedence:
#
#   1. ./.env                       per-checkout, for development
#        cp .env.example .env
#   2. ~/.config/clew/config.env    per-user, for an installed clew
#        mkdir -p ~/.config/clew && cp .env.example ~/.config/clew/config.env
#        chmod 600 ~/.config/clew/config.env      # it can hold a password
#
# Anything already exported in the environment wins over both, so a variable set
# for a single run still overrides the file. clew loads these itself — you no
# longer need `set -a; source .env; set +a`, though that still works.
#
# Run `clew doctor` after editing to confirm clew sees what you expect.

# --- Channel 2: Binary Ninja (the core channel) ------------------------------
# Directory CONTAINING the `binaryninja` package, i.e. the API directory of a
# Binary Ninja install. Required when clew is installed in an isolated
# environment (pipx, uv tool), because Binary Ninja's install_api.py writes its
# .pth into one specific site-packages that such an install does not share.
# Leave unset if `import binaryninja` already works in clew's environment.
CLEW_BN_API=/path/to/binaryninja/python

# Binary Ninja Enterprise credentials, used by the in-process license checkout.
# Without these, `clew static` fails at checkout unless a seat is already held
# or --no-license-checkout is passed.
BN_ENTERPRISE_SERVER=https://binaryninja.example.com
BN_ENTERPRISE_USERNAME=your-username
BN_ENTERPRISE_PASSWORD=your-password

# --- Channel 0: capa ---------------------------------------------------------
# capa rules checkout and signatures. capa 9.4.0 ships its sigs in the source
# tree, not in the installed package. capa is enrichment: if these are wrong the
# pipeline degrades to derivation_status=no_capa_signal rather than failing.
CLEW_CAPA_RULES=/path/to/capa-rules
CLEW_CAPA_SIGS=/path/to/capa-src/sigs

# --- Channel 3: CAPE ---------------------------------------------------------
# CAPE apiv2 base URL, used by the detonate / tasks / run verbs.
CAPE_BASE_URL=http://127.0.0.1:8000
